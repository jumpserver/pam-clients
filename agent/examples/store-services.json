{
  "endpoint": "https://jumpserver.example.com",
  "app_id": "<application-id>",
  "app_secret": "<application-secret>",
  "org_id": "<org-id>",
  "pull_interval": 300,
  "store": {
    "accounts": [
      "all"
    ],
    "root": "/opt/jumpserver-pam/credentials",
    "format": "json",
    "owner": "appuser"
  },
  "services": [
    {
      "name": "sample-app",
      "accounts": [
        {
          "username": "db_app_a",
          "alias": "database",
          "id": "<primary-account-id>"
        },
        {
          "alias": "cache",
          "id": "<cache-account-id>"
        }
      ],
      "allow_account_switch": true,
      "update_on_notification": true,
      "update_config": {
        "file": "/etc/sample-app/config.yml",
        "format": "yaml",
        "fields_map": {
          "DB_USER": "database.username",
          "DB_PASSWORD": "database.secret",
          "CACHE_USER": "cache.username",
          "CACHE_PASSWORD": "cache.secret"
        }
      },
      "reload_service": {
        "unit": "sample-app.service",
        "operation": "restart"
      },
      "app_check": {
        "path": "/usr/local/libexec/check-sample-app",
        "confirm_on_success": true
      }
    },
    {
      "name": "report-worker",
      "accounts": [
        {
          "username": "report_reader",
          "id": "<report-account-id>"
        }
      ],
      "update_on_notification": false,
      "update_config": {
        "files": [
          {
            "path": "/etc/report-worker/database.env",
            "format": "environment",
            "owner": "appuser"
          }
        ]
      }
    }
  ],
  "version": 1,
  "socket": {
    "owner": "appuser"
  }
}
